# Copy to .env and fill in what you want. Every key is optional: see the README's
# "API keys" table for what each one switches on and where to get it.

# Session transcription
ASSEMBLYAI_API_KEY=

# AI drafting and pictures
GEMINI_API_KEY=

# Soundboard "Find more" sources
FREESOUND_API_KEY=
YOUTUBE_API_KEY=

# Ask for a password in the browser (any username). Set this if anyone else can
# reach bafft on your network.
BAFFT_PASSWORD=
