{
  "name": "@bafft/server",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/db/*.test.ts src/asr/*.test.ts src/routes/*.test.ts src/gemini/*.test.ts src/npc/*.test.ts src/labelling/*.test.ts src/sound/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "fixtures:run": "tsx src/asr/run-fixtures.ts"
  },
  "dependencies": {
    "@bafft/shared": "*",
    "@libsql/client": "^0.14.0",
    "double-metaphone": "^2.0.1",
    "drizzle-orm": "^0.38.2",
    "express": "^4.21.2",
    "multer": "^2.3.0",
    "tsx": "^4.19.2",
    "wordlist-english": "^1.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2"
  }
}
