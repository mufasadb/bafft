/data/fixtures/**/*.wav
/data/fixtures/**/*.mp3
/data/fixtures/**/*.m4a
/data/fixtures/**/*.flac

# Env
.env
.env.local

# Claude Code local settings (personal overrides, may contain secrets)
.claude/settings.local.json

# Editor / OS
.DS_Store
.vscode/
.idea/

# Beads root-level runtime gate locks (the DB + inner locks are handled by .beads/.gitignore)
/.beads.gate.lock
/.beads.gate.lock.info

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

